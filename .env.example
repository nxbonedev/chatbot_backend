# Required: create a Google AI Studio API key and add it to Render Environment.
GOOGLE_API_KEY=your_google_api_key_here
# Optional model overrides
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
# Optional: set these to /var/data/... if you attach a Render persistent disk.
INDEX_PATH=faiss_multipage_index
DB_PATH=backend/chat_history.db
